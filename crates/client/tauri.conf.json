{
  "productName": "Eris",
  "version": "0.1.0",
  "identifier": "com.eris.unified",
  "build": {
    "frontendDist": "../../../www",
    "devUrl": null,
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Eris Unified",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' ws: wss: http: https: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
